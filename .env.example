# Tendly environment variables
# Copy to .env and fill in real values. NEVER commit .env.

# Deepgram (speech-to-text)
DEEPGRAM_API_KEY=

# Anthropic Claude (AI triage + summaries)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Redis (memory layer). Format: redis://default:<password>@<host>:<port>
REDIS_URL=

# Arize (observability) - optional
ARIZE_API_KEY=
ARIZE_SPACE_ID=

# Sentry (error tracking) - optional
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Backend URL used by the frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Toggle: when true, integrations fall back to deterministic mocks if creds are missing
TENDLY_ALLOW_MOCKS=true
